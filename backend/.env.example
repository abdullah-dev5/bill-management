# Copy to .env (git-ignored) or export these in your shell.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bill_dev?sslmode=disable
APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:5173
TICK_TOKEN=dev-tick-token-change-me-0123456789
# Encrypts reference numbers and signs file links. A fixed development key is used when unset;
# production must set its own (at least 32 characters) and keep it safe.
# DATA_ENCRYPTION_KEY=
# Documents: stored under STORAGE_DIR on local disk unless S3_ENDPOINT is set.
# STORAGE_DIR=var/storage
# STORAGE_QUOTA_MB=100
# S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_DIRECT_UPLOADS=true
# RESEND_API_KEY=
# MAIL_FROM=Bill Manager <onboarding@resend.dev>
